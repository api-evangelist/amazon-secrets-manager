{
  "@context": {
    "@vocab": "https://schema.org/",
    "aws": "https://aws.amazon.com/schemas/",
    "secretsmanager": "https://docs.aws.amazon.com/secretsmanager/latest/apireference/",
    "Secret": "aws:SecretsManager/Secret",
    "ARN": {
      "@id": "aws:ARN",
      "@type": "@id"
    },
    "Name": "name",
    "Description": "description",
    "KmsKeyId": {
      "@id": "aws:KmsKeyId",
      "@type": "@id"
    },
    "RotationEnabled": {
      "@id": "secretsmanager:RotationEnabled",
      "@type": "http://www.w3.org/2001/XMLSchema#boolean"
    },
    "RotationLambdaARN": {
      "@id": "secretsmanager:RotationLambdaARN",
      "@type": "@id"
    },
    "RotationRules": {
      "@id": "secretsmanager:RotationRules",
      "@type": "@id"
    },
    "AutomaticallyAfterDays": {
      "@id": "secretsmanager:AutomaticallyAfterDays",
      "@type": "http://www.w3.org/2001/XMLSchema#integer"
    },
    "Duration": {
      "@id": "secretsmanager:Duration",
      "@type": "http://www.w3.org/2001/XMLSchema#string"
    },
    "ScheduleExpression": {
      "@id": "secretsmanager:ScheduleExpression",
      "@type": "http://www.w3.org/2001/XMLSchema#string"
    },
    "LastRotatedDate": {
      "@id": "secretsmanager:LastRotatedDate",
      "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
    },
    "LastChangedDate": {
      "@id": "dateModified",
      "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
    },
    "LastAccessedDate": {
      "@id": "secretsmanager:LastAccessedDate",
      "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
    },
    "DeletedDate": {
      "@id": "secretsmanager:DeletedDate",
      "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
    },
    "CreatedDate": {
      "@id": "dateCreated",
      "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
    },
    "Tags": {
      "@id": "keywords",
      "@container": "@set"
    },
    "Key": "name",
    "Value": "value",
    "SecretVersionsToStages": {
      "@id": "secretsmanager:SecretVersionsToStages",
      "@type": "@id"
    },
    "OwningService": {
      "@id": "secretsmanager:OwningService",
      "@type": "http://www.w3.org/2001/XMLSchema#string"
    },
    "PrimaryRegion": {
      "@id": "aws:Region",
      "@type": "http://www.w3.org/2001/XMLSchema#string"
    }
  }
}
